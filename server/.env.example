# Copy to .env and fill in. Never commit the real .env.

PORT=8787

# Microsoft 365 SMTP for order@endlessfun.biz
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=order@endlessfun.biz
SMTP_PASS=            # the mailbox password or an app password
MAIL_FROM=Endless Fun <order@endlessfun.biz>

# Business-card scanning (AI vision)
ANTHROPIC_API_KEY=        # from console.anthropic.com — enables card scanning

# SOS Inventory (shared product catalog)
SOS_BASE_URL=https://api.sosinventory.com
SOS_CLIENT_ID=            # from the SOS Developer Portal app
SOS_CLIENT_SECRET=        # from the SOS Developer Portal app
SOS_ACCESS_TOKEN=         # from the OAuth authorization step
SOS_REFRESH_TOKEN=        # from the OAuth authorization step (rotates)
