# Copy to .env and fill in. Never commit the real .env.

PORT=8787

# Microsoft 365 SMTP for order@endlessfun.biz
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=order@endlessfun.biz
SMTP_PASS=            # the mailbox password or an app password
MAIL_FROM=Endless Fun <order@endlessfun.biz>

# Business-card scanning (AI vision)
ANTHROPIC_API_KEY=        # from console.anthropic.com — enables card scanning

# SOS Inventory (shared product catalog)
SOS_BASE_URL=https://api.sosinventory.com
SOS_CLIENT_ID=            # from the SOS Developer Portal app
SOS_CLIENT_SECRET=        # from the SOS Developer Portal app
SOS_ACCESS_TOKEN=         # from the OAuth authorization step
SOS_REFRESH_TOKEN=        # from the OAuth authorization step (rotates)

# Salesforce (Lead + Opportunity per order). Server-to-server via a Connected
# App using the OAuth 2.0 Client Credentials Flow. TEST IN THE SANDBOX FIRST.
# Leave blank to disable the Salesforce push (orders + email still work).
SF_LOGIN_URL=             # https://test.salesforce.com (sandbox) or https://login.salesforce.com (prod)
SF_CLIENT_ID=             # Connected App Consumer Key
SF_CLIENT_SECRET=         # Connected App Consumer Secret
SF_API_VERSION=v62.0
SF_LEAD_SOURCE=Trade Show # default Lead Source when the order has no event name
SF_OPP_STAGE=Proposal     # an OPEN stage; avoid Closed Won so Send-to-SOS doesn't fire in testing
SF_CREATE_OPPORTUNITY=1   # set to 0 to create only the Lead
SF_ADD_LINE_ITEMS=1       # 1 = real OpportunityLineItems (match by SOS_Item_Id__c/SKU); 0 = header only
# SF_PRICEBOOK_ID=        # optional; otherwise the Standard Price Book is auto-detected
SF_LINK_ACCOUNT=1         # 1 = match/create the Account (by SOS_Customer_Id__c then name) and link it
SF_CREATE_ACCOUNT=1       # 1 = create a new Account when none matches (only if a company name is present)
SF_DEFAULT_REP_SOS_ID=    # booth fallback rep as an SOS rep id, e.g. 5 (House) or 2 (Chris Roseen)
# SF_REP_MAP=             # optional JSON to extend the rep name->SOS id map, e.g. {"Pat Smith":"2"}
