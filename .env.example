# ---------------------------------------------------------------------------
# WalmartCheck -> QuickBooks Online  |  environment configuration
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# Intuit app credentials. Create an app at https://developer.intuit.com,
# add the "Accounting" scope, and copy the keys from the "Keys & credentials"
# tab (use the Development keys for the sandbox, Production keys when live).
QBO_CLIENT_ID=your_client_id_here
QBO_CLIENT_SECRET=your_client_secret_here

# "sandbox" while testing, "production" when connecting a real company file.
QBO_ENVIRONMENT=sandbox

# Must EXACTLY match a Redirect URI configured on your Intuit app.
QBO_REDIRECT_URI=http://localhost:3000/auth/callback

# Where the app runs.
PORT=3000

# Secret used to sign the login session cookie. Use a long random string.
SESSION_SECRET=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Hosting only (leave unset for local use). See HOSTING.md.
# ---------------------------------------------------------------------------
# Team password to open the app. When set, the app shows a login screen.
# Leave unset locally and there is no password.
# APP_PASSWORD=

# Persist tokens/history/settings to this directory (a persistent disk when
# hosted). Defaults to the local ./data folder when unset.
# DATA_DIR=/var/data

# Set to "true" when behind an HTTPS proxy (e.g. Render) so session cookies
# are marked secure. Leave unset locally.
# SECURE_COOKIES=true
